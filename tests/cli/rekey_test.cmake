# 复用已加密的低成本夹具，换密本身不依赖系统明文暂存目录。
set(rekey_system_temporary "${TEST_DIR}/unavailable-rekey-temporary")
set(rekey_source "${TEST_DIR}/验证 密文 🔐.fcry")
file(SHA256 "${rekey_source}" rekey_original_hash)
file(WRITE "${TEST_DIR}/rekey-password.txt" "test password \nreplacement password \nreplacement password \n")
file(WRITE "${TEST_DIR}/rekey-back-password.txt" "replacement password \ntest password \ntest password \n")
file(WRITE "${TEST_DIR}/rekey-new-password.txt" "replacement password \n")
file(WRITE "${TEST_DIR}/rekey-wrong-password.txt" "wrong password\nreplacement password \nreplacement password \n")
file(WRITE "${TEST_DIR}/rekey-mismatch.txt" "test password \nreplacement password \ndifferent\n")
file(WRITE "${TEST_DIR}/rekey-empty-new.txt" "test password \n\n\n")
file(WRITE "${TEST_DIR}/rekey-missing-confirmation.txt" "test password \nreplacement password \n")

# 两种名称共用成功、失败及清理断言；stdout 只在成功时报告最终路径。
function(run_rekey password_file expected expected_text)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "TMPDIR=${rekey_system_temporary}" "TMP=${rekey_system_temporary}" "TEMP=${rekey_system_temporary}"
        "${FILECRYPT}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}" INPUT_FILE "${TEST_DIR}/${password_file}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "换密退出状态不符：${result}\n${error}")
    endif()
    if(expected EQUAL 0)
        string(FIND "${output}" "${expected_text}" path_position)
        if(NOT output MATCHES "换密完成" OR path_position EQUAL -1)
            message(FATAL_ERROR "换密未报告实际输出路径：${output}")
        endif()
    elseif(NOT output STREQUAL "" OR NOT error MATCHES "${expected_text}")
        message(FATAL_ERROR "换密错误提示不符：${output}\n${error}")
    endif()
    if(output MATCHES "test password|replacement password" OR error MATCHES "test password|replacement password")
        message(FATAL_ERROR "换密输出暴露了输入密码")
    endif()
    file(GLOB temporary "${TEST_DIR}/.filecrypt-*" "${rekey_system_temporary}/*")
    if(temporary OR EXISTS "${rekey_system_temporary}")
        message(FATAL_ERROR "换密遗留临时文件或创建系统暂存目录：${temporary}")
    endif()
    set(rekey_last_error "${error}" PARENT_SCOPE)
endfunction()

# 长短命令均覆盖另存和替换；省略后缀也应得到同一个输入及明确的 .fcry 输出。
foreach(command IN ITEMS rekey -r)
    set(rekey_output "${TEST_DIR}/换密 ${command} 🔑.fcry")
    set(rekey_restored "${TEST_DIR}/换密恢复 ${command}.bin")
    run_rekey(rekey-password.txt 0 "换密 ${command} 🔑.fcry"
        ${command} "${TEST_DIR}/验证 密文 🔐" "${TEST_DIR}/换密 ${command} 🔑")
    run_success(rekey-new-password.txt decrypt "${rekey_output}" "${rekey_restored}")
    file(SHA256 "${source}" rekey_plain_hash)
    file(SHA256 "${rekey_restored}" rekey_restored_hash)
    if(NOT rekey_plain_hash STREQUAL rekey_restored_hash)
        message(FATAL_ERROR "换密后文件内容不一致")
    endif()
    run_failure(decrypt-password.txt "${TEST_DIR}/old-password.bin"
        decrypt "${rekey_output}" "${TEST_DIR}/old-password.bin")
    file(SHA256 "${rekey_source}" rekey_after_hash)
    if(NOT rekey_original_hash STREQUAL rekey_after_hash)
        message(FATAL_ERROR "另存换密修改了原密文")
    endif()
    file(SHA256 "${rekey_output}" rekey_before_replace)
    # --replace 可以放在资源选项之后，两种拼写均不得改变语义。
    run_rekey(rekey-back-password.txt 0 "换密 ${command} 🔑.fcry"
        ${command} "${rekey_output}" max-memory-kib 8192 --replace)
    file(SHA256 "${rekey_output}" rekey_after_replace)
    if(rekey_before_replace STREQUAL rekey_after_replace)
        message(FATAL_ERROR "显式替换没有更新密文")
    endif()
    run_success(decrypt-password.txt verify "${rekey_output}")
    run_failure(rekey-new-password.txt "${TEST_DIR}/replaced-old-password.bin"
        decrypt "${rekey_output}" "${TEST_DIR}/replaced-old-password.bin")
endforeach()

set(rekey_rejected "${TEST_DIR}/rekey-rejected.fcry")
run_rekey(rekey-wrong-password.txt 1 "认证失败" rekey "${rekey_source}" "${rekey_rejected}")
run_rekey(rekey-mismatch.txt 1 "两次新密码不一致" rekey "${rekey_source}" "${rekey_rejected}")
run_rekey(rekey-empty-new.txt 1 "新密码不能为空" -r "${rekey_source}" "${rekey_rejected}")
run_rekey(empty-password.txt 1 "旧密码不能为空" -r "${rekey_source}" "${rekey_rejected}")
run_rekey(rekey-missing-confirmation.txt 1 "Password input ended" rekey "${rekey_source}" "${rekey_rejected}")
run_rekey(rekey-password.txt 1 "资源.*上限" rekey "${rekey_source}" "${rekey_rejected}" max-memory-kib 4096)
run_rekey(rekey-password.txt 1 "资源.*上限" rekey "${rekey_source}" "${rekey_rejected}" max-output-bytes 1)
run_rekey(rekey-wrong-password.txt 1 "认证失败" -r "${rekey_source}" --replace)
if(EXISTS "${rekey_rejected}")
    message(FATAL_ERROR "换密失败发布了输出")
endif()

# 解析和路径错误应在读取任何密码之前拒绝。
function(reject_rekey_option expected)
    run_rekey(empty-password.txt 1 "${expected}" ${ARGN})
    if(rekey_last_error MATCHES "旧密码：")
        message(FATAL_ERROR "换密参数错误发生前读取了密码：${ARGN}")
    endif()
endfunction()
reject_rekey_option("指定输出文件" rekey "${rekey_source}")
reject_rekey_option("未知或不适用" rekey "${rekey_source}" "${rekey_rejected}" --replace)
reject_rekey_option("未知或不适用" -r "${rekey_source}" "${rekey_rejected}" algorithm aes)
reject_rekey_option("未知或不适用" rekey "${rekey_source}" "${rekey_rejected}" compress)
reject_rekey_option("未知或不适用" -r "${rekey_source}" "${rekey_rejected}" extra-output)
reject_rekey_option("选项重复" -r "${rekey_source}" --replace --replace)
reject_rekey_option("选项重复" rekey "${rekey_source}" "${rekey_rejected}" max-memory-kib 8192 max-memory-kib 8192)
reject_rekey_option("选项缺少值" rekey "${rekey_source}" "${rekey_rejected}" max-memory-kib)
reject_rekey_option("正的 32 位整数" -r "${rekey_source}" "${rekey_rejected}" max-memory-kib 0)
reject_rekey_option("输入与输出不能相同" rekey "${rekey_source}" "${rekey_source}")
reject_rekey_option("普通文件" -r "${TEST_DIR}/nonexistent.fcry" "${rekey_rejected}")
reject_rekey_option("目录" rekey "${rekey_source}" "${TEST_DIR}/nonexistent/output.fcry")
file(WRITE "${rekey_rejected}" "existing output")
file(SHA256 "${rekey_rejected}" rekey_existing_hash)
reject_rekey_option("输出已存在" rekey "${rekey_source}" "${rekey_rejected}")
file(SHA256 "${rekey_rejected}" rekey_existing_after)
if(NOT rekey_existing_hash STREQUAL rekey_existing_after)
    message(FATAL_ERROR "换密覆盖了已有目标")
endif()
file(REMOVE "${rekey_rejected}")
file(SHA256 "${rekey_source}" rekey_final_hash)
if(NOT rekey_original_hash STREQUAL rekey_final_hash OR EXISTS "${rekey_rejected}")
    message(FATAL_ERROR "换密失败修改了输入或发布了输出")
endif()
