# 密码输出只在测试内存中检查，失败日志不包含生成内容。
function(check_generated_password length charset)
    execute_process(COMMAND "${FILECRYPT}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "密码生成失败：${error}")
    endif()
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "重定向密码输出时出现额外提示")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    string(LENGTH "${output}" actual_length)
    math(EXPR expected_length "${length} + 1")
    if(NOT actual_length EQUAL expected_length)
        message(FATAL_ERROR "密码输出长度或单行格式不符合约定")
    endif()
    string(SUBSTRING "${output}" ${length} 1 ending)
    if(NOT ending STREQUAL "\n")
        message(FATAL_ERROR "密码输出缺少换行")
    endif()
    string(SUBSTRING "${output}" 0 ${length} password)
    if(charset STREQUAL "symbols")
        set(allowed "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%&*+-=?@_")
    elseif(charset STREQUAL "readable")
        set(allowed "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789")
    else()
        set(allowed "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789")
    endif()
    math(EXPR last_character "${length} - 1")
    foreach(index RANGE 0 ${last_character})
        string(SUBSTRING "${password}" ${index} 1 character)
        string(FIND "${allowed}" "${character}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "密码输出含有字符集之外的字符")
        endif()
    endforeach()
endfunction()

function(reject_password_options)
    execute_process(COMMAND "${FILECRYPT}" -g ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result EQUAL 1 OR NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "非法密码生成参数未在输出前拒绝")
    endif()
endfunction()

foreach(command IN ITEMS password -g)
    check_generated_password(12 alnum ${command})
    foreach(charset IN ITEMS alnum readable symbols)
        foreach(length IN ITEMS 8 12 64)
            check_generated_password(${length} ${charset} ${command} length ${length} charset ${charset})
        endforeach()
    endforeach()
endforeach()
check_generated_password(12 readable -g charset readable)
check_generated_password(24 alnum -g length 24)
check_generated_password(8 symbols -g charset symbols length 8)
foreach(length IN ITEMS 0 7 65 -1 +12 12x 9999999999999999999999999999999999)
    reject_password_options(length ${length})
endforeach()
reject_password_options(length "")
reject_password_options(length)
reject_password_options(charset)
reject_password_options(charset unknown)
reject_password_options(length 12 length 16)
reject_password_options(charset alnum charset readable)
reject_password_options(unknown)
reject_password_options(--length 12)

# Linux 的满设备确定性触发写出失败，不把密码写入真实文件。
if(UNIX AND EXISTS "/dev/full")
    execute_process(COMMAND "${FILECRYPT}" -g RESULT_VARIABLE result
        OUTPUT_FILE "/dev/full" ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result EQUAL 1 OR NOT error MATCHES "密码输出失败")
        message(FATAL_ERROR "密码输出失败未返回约定退出码")
    endif()
endif()
