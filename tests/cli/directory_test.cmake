# 输出只允许创建者和 SYSTEM 访问；不同账户不能复用上一轮夹具。
# 每次使用独立目录，也避免同时运行测试时互相删除恢复目标。
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run_root "${TEST_DIR}/run-${run_id}")
if(EXISTS "${run_root}")
    message(FATAL_ERROR "测试目录已存在：${run_root}")
endif()
set(TEST_DIR "${run_root}/目录 空格 🔐")
file(MAKE_DIRECTORY "${TEST_DIR}/source/sub/empty" "${TEST_DIR}/source/empty" "${TEST_DIR}/empty-source")
file(WRITE "${TEST_DIR}/source/中文 🔑.txt" "directory contents\n")
file(WRITE "${TEST_DIR}/source/sub/zero" "")
string(REPEAT "streaming data\n" 10000 data)
file(WRITE "${TEST_DIR}/source/sub/data.bin" "${data}")
file(WRITE "${TEST_DIR}/encrypt-password.txt" "directory password\ndirectory password\n")
file(WRITE "${TEST_DIR}/decrypt-password.txt" "directory password\n")
file(WRITE "${TEST_DIR}/wrong-password.txt" "wrong\n")

function(run password expected)
    execute_process(COMMAND "${FILECRYPT}" ${ARGN}
        WORKING_DIRECTORY "${TEST_DIR}" INPUT_FILE "${TEST_DIR}/${password}-password.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(expected AND NOT result EQUAL 0)
        message(FATAL_ERROR "目录命令失败：${ARGN}\n退出结果：${result}\n${output}\n${error}")
    elseif(NOT expected AND result EQUAL 0)
        message(FATAL_ERROR "非法目录操作未拒绝：${ARGN}")
    endif()
    file(GLOB temporary "${TEST_DIR}/.filecrypt-*")
    if(temporary)
        message(FATAL_ERROR "目录命令遗留临时输出：${temporary}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

foreach(algorithm IN ITEMS aes xchacha)
    foreach(compressed IN ITEMS no-compress compress)
        set(encrypted "${algorithm}-${compressed}.fcry")
        set(output "${TEST_DIR}/恢复 🔓-${algorithm}-${compressed}")
        file(REMOVE "${TEST_DIR}/${encrypted}")
        # 清理仅限本轮夹具中的恢复目标，并立即确认清理成功。
        file(REMOVE_RECURSE "${output}")
        if(EXISTS "${output}")
            message(FATAL_ERROR "无法清理本轮恢复目标：${output}")
        endif()
        run(encrypt TRUE -e source "${algorithm}-${compressed}" -a "${algorithm}" "${compressed}"
            memory-kib 8192 iterations 1 parallelism 1)
        run(decrypt TRUE -i "${encrypted}")
        if(NOT last_output MATCHES "目录：是" OR NOT last_output MATCHES "文件类型：N/A")
            message(FATAL_ERROR "目录信息不正确：${last_output}")
        endif()
        run(wrong FALSE -d "${encrypted}" "${output}")
        run(decrypt FALSE -d "${encrypted}" "${output}" max-entries 1)
        run(decrypt FALSE -d "${encrypted}" "${output}" max-index-bytes 1)
        run(decrypt FALSE -d "${encrypted}" "${output}" max-name-bytes 1)
        run(decrypt FALSE -d "${encrypted}" "${output}" max-depth 1)
        run(decrypt FALSE -d "${encrypted}" "${output}" max-output-bytes 1)
        run(decrypt FALSE -d "${encrypted}" "${output}" max-archive-bytes 1)
        if(EXISTS "${output}")
            message(FATAL_ERROR "失败操作发布了目录：${output}")
        endif()
        run(decrypt TRUE -d "${encrypted}" "${output}")
        foreach(path IN ITEMS "中文 🔑.txt" sub/zero sub/data.bin)
            file(SHA256 "${TEST_DIR}/source/${path}" before)
            file(SHA256 "${output}/${path}" after)
            if(NOT before STREQUAL after)
                message(FATAL_ERROR "目录文件内容不一致：${path}")
            endif()
        endforeach()
        if(NOT IS_DIRECTORY "${output}/empty" OR NOT IS_DIRECTORY "${output}/sub/empty" OR EXISTS "${output}/source")
            message(FATAL_ERROR "目录结构或空目录恢复错误")
        endif()
        run(decrypt FALSE -d "${encrypted}" "${output}")
        file(SHA256 "${output}/sub/data.bin" after_conflict)
        file(SHA256 "${TEST_DIR}/source/sub/data.bin" original)
        if(NOT original STREQUAL after_conflict)
            message(FATAL_ERROR "已有目录被更改")
        endif()
    endforeach()
endforeach()

file(REMOVE "${TEST_DIR}/empty.fcry")
file(REMOVE_RECURSE "${TEST_DIR}/empty-restored")
run(encrypt TRUE encrypt empty-source empty -z memory-kib 8192 iterations 1 parallelism 1)
run(decrypt TRUE decrypt empty empty-restored)
file(GLOB empty_contents "${TEST_DIR}/empty-restored/*")
if(NOT IS_DIRECTORY "${TEST_DIR}/empty-restored" OR empty_contents)
    message(FATAL_ERROR "空目录恢复失败")
endif()
file(REMOVE_RECURSE "${TEST_DIR}/trailing-restored")
run(decrypt TRUE decrypt empty "trailing-restored/")
if(NOT IS_DIRECTORY "${TEST_DIR}/trailing-restored")
    message(FATAL_ERROR "带末尾分隔符的目录目标恢复失败")
endif()
run(encrypt FALSE encrypt source source/inside memory-kib 8192 iterations 1 parallelism 1)
if(EXISTS "${TEST_DIR}/source/inside.fcry")
    message(FATAL_ERROR "目录内输出未拒绝")
endif()
run(encrypt FALSE encrypt source limited max-entries 1 memory-kib 8192 iterations 1 parallelism 1)
if(EXISTS "${TEST_DIR}/limited.fcry")
    message(FATAL_ERROR "扫描限制失败仍发布了密文")
endif()

if(WIN32)
    # junction 不需要符号链接权限，验证根和树内 reparse point 都明确失败。
    if(NOT EXISTS "${TEST_DIR}/junction")
        execute_process(COMMAND cmd /c mklink /J "${TEST_DIR}/junction" "${TEST_DIR}/source"
            RESULT_VARIABLE linked OUTPUT_QUIET ERROR_QUIET)
        if(NOT linked EQUAL 0)
            message(FATAL_ERROR "Cannot create junction fixture")
        endif()
    endif()
    run(encrypt FALSE encrypt junction junction-output memory-kib 8192 iterations 1 parallelism 1)
    # 词法消去 .. 之前也必须拒绝路径中的 junction。
    file(REMOVE "${TEST_DIR}/cancelled-link.fcry")
    run(encrypt FALSE encrypt junction/../empty-source cancelled-link memory-kib 8192 iterations 1 parallelism 1)
    if(NOT EXISTS "${TEST_DIR}/source/junction")
        execute_process(COMMAND cmd /c mklink /J "${TEST_DIR}/source/junction" "${TEST_DIR}/empty-source"
            RESULT_VARIABLE linked OUTPUT_QUIET ERROR_QUIET)
        if(NOT linked EQUAL 0)
            message(FATAL_ERROR "Cannot create nested junction fixture")
        endif()
    endif()
    run(encrypt FALSE encrypt source junction-output memory-kib 8192 iterations 1 parallelism 1)
    # 原生 helper 核对 junction 类型及名称，只删除链接，不遍历其目标。
    foreach(junction IN ITEMS "${TEST_DIR}/junction" "${TEST_DIR}/source/junction")
        execute_process(COMMAND "${CLEANUP_TOOL}" --remove-junction "${junction}" RESULT_VARIABLE removed)
        if(NOT removed EQUAL 0)
            message(FATAL_ERROR "Cannot remove test junction safely")
        endif()
    endforeach()
endif()
# 仅清理本次创建的夹具；失败时保留现场供检查。
file(REMOVE_RECURSE "${run_root}")
if(EXISTS "${run_root}")
    message(FATAL_ERROR "无法清理本轮测试目录：${run_root}")
endif()
